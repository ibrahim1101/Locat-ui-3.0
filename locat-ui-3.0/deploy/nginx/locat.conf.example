# Install as /etc/nginx/sites-available/locat and enable it.
# Obtain and renew the certificate separately with your chosen ACME client.
server {
    listen 80;
    listen [::]:80;
    server_name locat.example.net;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name locat.example.net;

    ssl_certificate     /etc/letsencrypt/live/locat.example.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/locat.example.net/privkey.pem;
    client_max_body_size 16m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # The application uses this authenticated health socket for live connection status.
    location = /api/connect/socket {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
