# Install as /etc/nginx/sites-available/locat and enable it.
# Obtain and renew the certificate separately with your chosen ACME client.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name locat.example.net;

    ssl_certificate     /etc/letsencrypt/live/locat.example.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/locat.example.net/privkey.pem;
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
