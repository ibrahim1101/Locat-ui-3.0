# Copy to /etc/locat/locat.env and replace the sample origin.
LOCAT_HOST=127.0.0.1
LOCAT_PORT=8787
LOCAT_PUBLIC_ORIGIN=https://locat.example.net
LOCAT_TLS_TERMINATION=proxy
LOCAT_PROXY_PEERS=127.0.0.1
LOCAT_PROXY_CLIENT_IP_HEADER=x-forwarded-for
LOCAT_DATABASE_FILE=/var/lib/locat/locat.sqlite
LOCAT_STATIC_DIR=/opt/locat/dist
